# ==============================================================
# CONFIGURAÇÃO DE AMBIENTE - SUPERGESTÃO SAÚDE
# ==============================================================

# 1. Inteligência Artificial (Groq / Llama)
GROQ_API_KEY=

# 2. Envio de E-mails Automáticos Institucionais (Opcional)
# Se não preenchido, a plataforma opera no Modo Autônomo com simulação,
# auditoria interna e registro em tempo real.
# Para conectar a um servidor real da Prefeitura ou Secretaria (ex: Office 365, Gmail, SendGrid):
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=sg.saude@municipio.gov.br
SMTP_PASS=sua_senha_de_aplicativo_aqui
SMTP_FROM="SuperGestão Saúde <sg.saude@municipio.gov.br>"

# URL base da plataforma para links em e-mails
NEXT_PUBLIC_APP_URL=http://localhost:3000
